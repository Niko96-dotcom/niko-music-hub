# Swift build output
.build/
.swiftpm/
DerivedData/
dist/
*.xcresult

# Python bytecode (vendored skill scripts)
__pycache__/
*.py[cod]

# Logs — except checked-in test fixtures that happen to be .log files
*.log
!Tests/**/Fixtures/*.log

# macOS
.DS_Store
Bildschirmfoto*.png

# Local scratch: agent run output, UI captures, working dirs
tmp/
output/
.ai/runs/
.ai/ui-review-*.png
.ai/ui-review-tabs/

# Generated planning intel (regenerate with gsd-map-codebase)
.planning/codebase/

# Other agent harnesses' local state (not project source)
.commandcode/
.opencode/
goal-agents/

# Ultimate De-Slop runtime state (the skill itself is vendored under .cursor/skills/)
.deslop/

# Private working state: planning history, agent harness state, vendored skills.
# These live only on the maintainer's machine and never in the public tree.
.planning/
.ai/
.codex/
.cursor/
.claude/
.ultracode/
.audit/
